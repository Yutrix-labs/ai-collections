# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/collections_db

# Claude API
CLAUDE_API_KEY=sk-ant-api03-...

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Worker Settings
TRANSCRIPT_WORKER_POLL_INTERVAL=0.1
INSIGHTS_WORKER_POLL_INTERVAL=0.1

# AI Insights Configuration
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=500
LLM_MODEL=claude-sonnet-4-5-20250929

# Deduplication Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.85

# Rate Limiting (seconds)
RATE_LIMIT_SENTIMENT=45
RATE_LIMIT_INTENT=30
RATE_LIMIT_POLICY=60
