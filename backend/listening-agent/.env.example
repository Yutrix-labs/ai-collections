LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
BACKEND_URL=http://backend:8080

# LiveKit Egress -> S3 call recording (browser/livekit call mode).
LIVEKIT_EGRESS_ENABLED=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
# Public base URL of the bucket (defaults to https://<bucket>.s3.<region>.amazonaws.com if blank).
BUCKET_FILE_PATH=
# Optional key prefix inside the bucket (e.g. /opt/document/dev).
DESTINATION_PATH=
