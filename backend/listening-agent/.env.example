LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
BACKEND_URL=http://backend:8080

# --- Real-time translation (opt-in; default off keeps the existing flow) ---
# TRANSLATION_MODE=on enables bidirectional Gemini Live speech-to-speech
# translation. AGENT_LANG is the tele-caller's language (BCP-47, e.g. en/hi);
# the customer's language is auto-detected and mirrored back to them.
TRANSLATION_MODE=off
AGENT_LANG=en
GEMINI_API_KEY=
