# ── ws_telephony_bridge.py config ─────────────────────────────────────────────
# The bridge loads backend/listening-agent/.env, so LIVEKIT_* / AGENT_NAME / BACKEND_URL /
# BACKEND_API_KEY are already picked up from there. Only the vars below are bridge-specific.

# Bridge server
WS_BRIDGE_HOST=0.0.0.0
WS_BRIDGE_PORT=8090
# Shared secret Tata must echo back as ?token=... (part of the URL you configured in the portal).
WS_BRIDGE_AUTH_TOKEN=yutrix-demo-secret-123

# Normal flow: /call/start already dispatched the agent and the bridge resolves the room via
# GET /call/by-mobile/{mobile}. Set true ONLY for standalone smoke tests with no backend session —
# then the bridge mints its own room and dispatches the agent itself.
BRIDGE_DISPATCH_AGENT=false

# Identity whose audio is streamed back to the phone (the tele-caller's browser leg).
BRIDGE_AGENT_IDENTITY=human-agent

# Tata's VERIFIED media format (audio/x-mulaw, 8000 Hz, 8-bit) — per their bidirectional
# streaming spec. Don't change unless Tata's spec changes.
TELEPHONY_ENCODING=mulaw
TELEPHONY_SAMPLE_RATE=8000
BRIDGE_PUBLISH_SAMPLE_RATE=16000
# Tata requires >=160 bytes in multiples of 160 (160 bytes = 20ms of 8kHz mu-law).
OUT_CHUNK_BYTES=160

# Dump the first N raw inbound frames (schema debugging).
LOG_FIRST_N_FRAMES=5
