# ── ws_telephony_bridge.py config ─────────────────────────────────────────────
# Reuse the SAME LiveKit project the listening agent connects to (its .env), else the
# bridge joins a different project than the agent and they never meet.
LIVEKIT_URL=wss://mohan-joshi-e2t1b6ty.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=silent-transcriber-dev

# Bridge server
WS_BRIDGE_HOST=0.0.0.0
WS_BRIDGE_PORT=8090
# Shared secret Tata must echo back as ?token=... — MUST match the backend's BRIDGE_AUTH_TOKEN.
WS_BRIDGE_AUTH_TOKEN=change-me-long-random

# Public address of this bridge (only for the startup example log / standalone testing).
# For a demo this is your ngrok wss host, e.g. wss://abc123.ngrok-free.app
PUBLIC_BRIDGE_BASE_URL=wss://abc123.ngrok-free.app

# Integrated flow: backend dispatches the agent, so keep false. true = standalone test only.
BRIDGE_DISPATCH_AGENT=false
# Identity whose audio is streamed back to the phone (the tele-caller's browser leg).
BRIDGE_AGENT_IDENTITY=human-agent

# Tata media format — CONFIRM against Tata's spec. Telephony default is 8kHz mu-law.
TELEPHONY_ENCODING=mulaw          # mulaw | pcm16
TELEPHONY_SAMPLE_RATE=8000
TELEPHONY_WS_FRAMING=json         # json (Twilio-style envelope) | raw (binary frames)
BRIDGE_PUBLISH_SAMPLE_RATE=16000
LOG_FIRST_N_FRAMES=5              # auto-dump first N raw frames to reveal Tata's schema
